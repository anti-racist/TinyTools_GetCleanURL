# Ignore all .png files
*.png

# ...except the extension's own icons, which manifest.json loads. Ignoring the
# whole icons/ directory meant a newly added icon was silently left out of
# every commit, and the release shipped without it.
!icons/*.png

# ...and the design mockups kept beside the automatic-cleaner experiment.
!auto-clean/design/*.png

# Ignore all .txt files
*.txt

# The automatic-cleaner experiment builds here.
auto-clean/dist/
